// Game executable resources: icon (also used for the window and taskbar) and version info.
#include <winver.h>

// Optional art (see launcher/launcher.rc): the icon is the game's own. CMake defines
// JTH_LAUNCHER_ART when it's present. (The PlayStation button icons are drawn in code:
// src/button_prompts.cpp.)
#ifdef JTH_LAUNCHER_ART
1 ICON "../launcher/assets/icon.ico"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Jurassic: The Hunted Recompiled"
      VALUE "ProductName", "Jurassic: The Hunted Recompiled"
      VALUE "FileVersion", "1.0.1"
      VALUE "ProductVersion", "1.0.1"
      VALUE "OriginalFilename", "jurassichunted.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
